# 環境変数のテンプレート。値は入れずにキーだけを管理する。
# 実際の値は Vercel から取得する: vercel env pull .env.local
#
# Vercelが自動注入する VERCEL_* と、Neon統合が同時に生やす POSTGRES_* / PG* /
# DATABASE_URL_UNPOOLED などのエイリアスはここには書かない(コードは DATABASE_URL のみ使う)。
# scripts/ のデバッグ用スクリプトが読む THEME_ID / SHOT も対象外(実行時に都度指定する)。

# Neon Postgres の接続文字列(プール済みエンドポイント)
DATABASE_URL=

# cookie ID や IP をハッシュ化するときのソルト。変更すると既存のハッシュと不整合になる
HASH_SALT=

# Vercel Cron が /api/cron/recompute を叩くときの Authorization ヘッダの値
CRON_SECRET=

# Python Function(compute / embed)を呼ぶときの X-Internal-Key。未設定なら CRON_SECRET を流用
INTERNAL_API_KEY=

# 管理画面(/admin)のアクセスキー。未設定なら管理画面は無効
ADMIN_KEY=

# Cloudflare Turnstile のシークレット。ローカルは未設定で公式テストキーに落ちる
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile のサイトキー。ローカルは公式テストキー 1x00000000000000000000AA を使う
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 公開URL。canonical・OGP・sitemap の生成に使う。未設定なら本番ドメインに落ちる
NEXT_PUBLIC_SITE_URL=

# 通報・お問い合わせの運営通知先(任意。未設定なら通知しない)
DISCORD_WEBHOOK_URL=

# クラスタリング計算の呼び出し先。ローカルは scripts/compute-server.py を指す
COMPUTE_URL=http://localhost:8787

# 埋め込み生成の呼び出し先。ローカルは同じサーバーの /embed
EMBED_URL=http://localhost:8787/embed

# 開発サーバーへのアクセスを許可するオリジン(カンマ区切り。LAN内の実機確認用・dev専用)
DEV_ALLOWED_ORIGINS=
